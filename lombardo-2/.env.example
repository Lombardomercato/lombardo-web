NEXT_PUBLIC_SITE_URL=https://www.lombardomercato.com
# Token público opcional para verificar el dominio en Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Canal público oficial. Obligatorio para coordinar pagos.
NEXT_PUBLIC_WHATSAPP_URL=
# Datos públicos de retiro. Obligatorios antes de habilitar producción.
NEXT_PUBLIC_PICKUP_ADDRESS=
NEXT_PUBLIC_PICKUP_HOURS=
# FREE | FLAT_RATE | TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_COST_MODE=TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_FLAT_RATE=0

# Persistencia server-side Runia/Supabase. Nunca usar prefijo NEXT_PUBLIC_.
# Preview/Development exige development; Vercel Production exige production.
RUNIA_ENVIRONMENT=development
RUNIA_SUPABASE_URL=
RUNIA_SUPABASE_SECRET_KEY=
# Clave pública de Supabase Auth para /admin. No usar prefijo NEXT_PUBLIC_.
RUNIA_SUPABASE_PUBLISHABLE_KEY=
RUNIA_TENANT_SLUG=

# Bot web comercial. Secretos exclusivamente server-side. El secret dedicado
# es opcional; si falta se deriva de la credencial Runia ya existente.
AI_RATE_LIMIT_SECRET=
AI_SALES_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=

# Cálculo económico autoritativo del servidor.
# FREE | FLAT_RATE | TO_BE_CONFIRMED
DELIVERY_COST_MODE=TO_BE_CONFIRMED
DELIVERY_FLAT_RATE=0

# Mercado Pago Checkout Pro. TEST nunca admite el dominio oficial. LIVE exige
# Vercel + Runia Production y APP_URL=https://www.lombardomercato.com.
# Para el lanzamiento WhatsApp-only usar PAYMENTS_ENABLED=false; en ese caso
# APP_URL y las credenciales Mercado Pago no son necesarias.
APP_URL=
PAYMENTS_ENABLED=false
MERCADO_PAGO_MODE=TEST
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300

# Aviso operativo server-only por WhatsApp Business Platform / Cloud API.
# Mantener false hasta contar con número emisor, plantilla utility aprobada y token.
WHATSAPP_ORDER_NOTIFICATIONS_ENABLED=false
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_ORDER_NOTIFICATION_RECIPIENT=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=es_AR

# Estado del pedido al WhatsApp del cliente. Activar sólo cuando Meta apruebe
# una plantilla utility con 6 variables: nombre, pedido, título, detalle, total y URL.
WHATSAPP_CUSTOMER_STATUS_NOTIFICATIONS_ENABLED=false
WHATSAPP_CUSTOMER_STATUS_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_STATUS_TEMPLATE_LANGUAGE=es_AR

# Email transaccional: avisos operativos y estados enviados al cliente.
EMAIL_ORDER_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL_TO=
ORDER_NOTIFICATION_EMAIL_FROM=Lombardo Mercato <pedidos@lombardomercato.com>
