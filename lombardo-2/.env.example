NEXT_PUBLIC_SITE_URL=https://www.lombardomercato.com
# Canal público oficial. Obligatorio para coordinar pagos.
NEXT_PUBLIC_WHATSAPP_URL=
# Datos públicos de retiro. Obligatorios antes de habilitar producción.
NEXT_PUBLIC_PICKUP_ADDRESS=
NEXT_PUBLIC_PICKUP_HOURS=
# FREE | FLAT_RATE | TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_COST_MODE=TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_FLAT_RATE=0

# Persistencia server-side Runia/Supabase. Nunca usar prefijo NEXT_PUBLIC_.
# Preview/Development exige development; Vercel Production exige production.
RUNIA_ENVIRONMENT=development
RUNIA_SUPABASE_URL=
RUNIA_SUPABASE_SECRET_KEY=
# Clave pública de Supabase Auth para /admin. No usar prefijo NEXT_PUBLIC_.
RUNIA_SUPABASE_PUBLISHABLE_KEY=
RUNIA_TENANT_SLUG=

# Cálculo económico autoritativo del servidor.
# FREE | FLAT_RATE | TO_BE_CONFIRMED
DELIVERY_COST_MODE=TO_BE_CONFIRMED
DELIVERY_FLAT_RATE=0

# Mercado Pago Checkout Pro. TEST nunca admite el dominio oficial. LIVE exige
# Vercel + Runia Production y APP_URL=https://www.lombardomercato.com.
# Para el lanzamiento WhatsApp-only usar PAYMENTS_ENABLED=false; en ese caso
# APP_URL y las credenciales Mercado Pago no son necesarias.
APP_URL=
PAYMENTS_ENABLED=false
MERCADO_PAGO_MODE=TEST
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
