NEXT_PUBLIC_SITE_URL=https://www.lombardomercato.com
# Pendiente: completar cuando se confirme el número oficial.
NEXT_PUBLIC_WHATSAPP_URL=
# Datos de retiro. Mantener vacíos hasta confirmar la información oficial.
NEXT_PUBLIC_PICKUP_ADDRESS=
NEXT_PUBLIC_PICKUP_HOURS=
# FREE | FLAT_RATE | TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_COST_MODE=TO_BE_CONFIRMED
NEXT_PUBLIC_DELIVERY_FLAT_RATE=0

# Persistencia server-side Runia/Supabase DEV. Nunca usar prefijo NEXT_PUBLIC_.
# La aplicación rechaza RUNIA_ENVIRONMENT distinto de development y VERCEL_ENV=production.
RUNIA_ENVIRONMENT=development
RUNIA_SUPABASE_URL=
RUNIA_SUPABASE_SECRET_KEY=
RUNIA_TENANT_SLUG=

# Cálculo económico autoritativo del servidor.
# FREE | FLAT_RATE | TO_BE_CONFIRMED
DELIVERY_COST_MODE=TO_BE_CONFIRMED
DELIVERY_FLAT_RATE=0

# Mercado Pago Checkout Pro. TEST es el único modo permitido en esta etapa.
# APP_URL debe ser el alias HTTPS del Preview; el dominio productivo se rechaza.
APP_URL=
PAYMENTS_ENABLED=false
MERCADO_PAGO_MODE=TEST
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
